{
  "name": "@joeywallet/wallet-sdk",
  "version": "0.2.0",
  "description": "Dependency-free TypeScript SDK for the Joey Wallet browser extension (XLS-72d / Wallet Standard).",
  "license": "MIT",
  "homepage": "https://github.com/joeywallet/joey-wallet-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeywallet/joey-wallet-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/joeywallet/joey-wallet-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ts:check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.0.2",
    "react": "19.0.0",
    "typescript": "5.7.2",
    "xrpl": "4.2.5"
  },
  "keywords": [
    "xrpl",
    "wallet",
    "joey",
    "xls-72d",
    "wallet-standard"
  ]
}
